generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String   @unique
  password  String
  rol       String   @default("COMERCIANTE")
  telefono  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pymes Pyme[]
}

model Pyme {
  id          Int      @id @default(autoincrement())
  nombre      String
  tipo        String   @default("MINIMARKET")
  sector      String?
  ciudad      String?
  direccion   String?
  telefono    String?
  descripcion String?
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  productos Producto[]
  ventas    Venta[]

  @@index([userId])
}

model Producto {
  id          Int      @id @default(autoincrement())
  pymeId      Int
  nombre      String
  descripcion String?
  codigo      String
  categoria   String?
  precioVenta Float
  costo       Float
  estado      String   @default("ACTIVO")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pyme        Pyme           @relation(fields: [pymeId], references: [id])
  inventario  Inventario?
  ventas      Venta[]
  predicciones Prediccion[]

  @@unique([pymeId, codigo])
  @@index([pymeId])
}

model Inventario {
  id         Int      @id @default(autoincrement())
  productoId Int      @unique
  stockActual Int
  stockMinimo Int     @default(5)
  stockMaximo Int?
  ubicacion  String?
  updatedAt  DateTime @updatedAt

  producto   Producto @relation(fields: [productoId], references: [id])

  @@index([stockActual, stockMinimo])
}

model Venta {
  id            Int      @id @default(autoincrement())
  pymeId        Int
  productoId    Int
  cantidad      Int
  precioUnitario Float
  costoUnitario  Float
  total         Float
  fecha         DateTime @default(now())

  pyme          Pyme     @relation(fields: [pymeId], references: [id])
  producto      Producto @relation(fields: [productoId], references: [id])

  @@index([productoId, fecha])
  @@index([pymeId, fecha])
}

model Prediccion {
  id            Int      @id @default(autoincrement())
  productoId    Int
  fecha         DateTime
  demandaPredicha Float
  nivelConfianza Float
  rentabilidadPredicha Float
  estado        String   @default("PENDIENTE")
  createdAt     DateTime @default(now())

  producto      Producto @relation(fields: [productoId], references: [id])

  @@index([productoId, fecha])
}
